# Operating system and temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.temp
*.swp
*.swo
*~

# Per-user Obsidian state; shared app/appearance/core-plugin/graph settings stay tracked
obsidian/.obsidian/workspace*.json
obsidian/.obsidian/cache/
obsidian/.obsidian/plugins/*/data.json
obsidian/.obsidian/plugins/obsidian-git/main.js
obsidian/.obsidian/plugins/obsidian-git/manifest.json
obsidian/.obsidian/plugins/obsidian-git/styles.css
obsidian/.trash/

# Credentials and environment secrets (safe templates may be tracked)
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.key
*.p12
*.pfx
credentials.json
secrets.json
.netrc
.npmrc
.aws/
.ssh/

# Local dependencies and caches
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
backend/ml/artifacts/

# Application build/test outputs
.next/
dist/
*.tsbuildinfo
playwright-report/
.artifacts/test-results/
.artifacts/evidence/
.artifacts/backups/
.artifacts/review/
coverage/

# Local measurements contain device metadata
backend/local-agent/results/
.cupy/
# Tool debug logs, not arbitrary user log/measurement files
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

backend/ml/embedding-cache/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and build output
node_modules/
.next/
dist/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Private ML artifacts and generated data
backend/ml/artifacts/
backend/ml/embedding-cache/
backend/local-agent/results/
.artifacts/

# Local Obsidian settings and plugins
**/.obsidian/
