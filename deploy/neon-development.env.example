# Copy to root .env.neon.development.local. Never paste credentials in chat.
COREWISE_DB_ENV=neon-development
# Use the actual disposable development branch URLs from Neon, never production.
DATABASE_URL=
DIRECT_URL=
NEON_BRANCH_NAME=
# Set true only after rotating exposed credentials and checking the branch endpoint.
NEON_CREDENTIALS_ROTATED=false

# Optional for inspection; required for independent branch verification before cloud restores
# unless the server reports a matching neon.branch_id. Never put the API key in chat.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
