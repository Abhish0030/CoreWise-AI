# Single-host reference configuration. Copy outside the checkout with restrictive permissions.
# All secret placeholders MUST be replaced. This file contains no deployment credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
APP_ORIGIN=https://corewise.example.com
API_ORIGIN=http://127.0.0.1:4000
AGENT_API_ORIGIN=http://127.0.0.1:4000
ML_ORIGIN=http://127.0.0.1:8000
TRUST_PROXY=loopback
DATABASE_URL=postgresql://corewise:REPLACE_DATABASE_PASSWORD@127.0.0.1:55432/corewise?schema=public
SESSION_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET
ML_INTERNAL_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
ML_ARTIFACT_ROOT=/var/lib/corewise/artifacts
ML_EXPLANATION_TIMEOUT_SECONDS=60
LOG_LEVEL=info
# Leave these empty for the explicit unavailable assistant state.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=https://your-compatible-provider.example/v1
# For Groq set LLM_PROVIDER=groq; keep credentials private.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# LLM_MAX_OUTPUT_TOKENS=2048

# Neon production: select explicitly only after approved, verified cutover.
# COREWISE_DB_ENV=neon-production
# DIRECT_URL=copy-the-new-private-direct-connection-string
# NEON_BRANCH_NAME=production
# NEON_CREDENTIALS_ROTATED=true
# ML_EMBEDDING_CACHE=/private/persistent/corewise-embedding-cache
