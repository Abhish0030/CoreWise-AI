{
  "name": "corewise-ai",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-powered CPU-GPU workload predictor that estimates execution performance, recommends suitable processing units, and visualizes workload efficiency.",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('node:fs'); fs.mkdirSync('dist/prisma',{recursive:true}); fs.copyFileSync('src/prisma/contract.json','dist/prisma/contract.json');\"",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/composer": "0.38.0",
    "@prisma/composer-prisma-cloud": "0.38.0",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@types/node": "24.10.9",
    "prisma": "8.0.0-rc.33",
    "typescript": "5.9.3"
  },
  "overrides": {
    "effect": "4.0.5",
    "@effect/vitest": "4.0.5",
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/platform-node-shared": "4.0.5"
  }
}
